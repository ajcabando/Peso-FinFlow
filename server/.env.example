# FinFlow API — environment template.
#
# Copy to `.env` (gitignored) and fill in real values. The docker-compose
# stack loads this file into the `migrate` and `finflow-api` services, so
# `DATABASE_URL` must use the Compose service name `postgres` as the host.
#
#   cp .env.example .env   &&   edit .env
#
# Variables marked “Phase 4+” / “Phase 8+” are not validated yet and are
# listed so the template is stable across releases — set them when the
# feature lands.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=8080                       # container port (host port mapped in compose)
API_PREFIX=/v1                  # all routes except /health live under this
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent

# Comma-separated origin allow-list for CORS (Flutter web needs the API origin
# here once sync ships). Empty = no cross-origin requests allowed.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Host MUST be `postgres` inside the compose network. User/password/db must
# match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in the root .env.
DATABASE_URL=postgres://finflow:change-me@postgres:5432/finflow

# ---------------------------------------------------------------------------
# Rate limiting (global, per-IP)
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# ---------------------------------------------------------------------------
# Authentication (Phase 2) — validated at boot
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-64-random-chars-openssl-rand-base64-48
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Argon2id password hashing (OWASP parameters — only change with reason)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Email verification + password reset. EMAIL_VERIFICATION_REQUIRED=true
# requires SMTP_HOST (fail-fast at boot). Empty SMTP_HOST disables mail and
# verification is skipped (verification.sent=false).
EMAIL_VERIFICATION_REQUIRED=false
APP_URL=http://localhost:8080

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FinFlow <no-reply@finflow.example.com>"

# Brute-force protection (in-memory; Redis-backed from Phase 8)
AUTH_MAX_ATTEMPTS_PER_MINUTE=5
AUTH_MAX_FAILURES_PER_HOUR=10

# ---------------------------------------------------------------------------
# Object storage (MinIO, Phase 4) — empty MINIO_ENDPOINT disables storage
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=finflow
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=finflow
MINIO_USE_SSL=false
MAX_ATTACHMENT_BYTES=26214400

# ---------------------------------------------------------------------------
# Backups (Phase 4)
# ---------------------------------------------------------------------------
BACKUP_RETENTION=10
MAX_BACKUP_BYTES=104857600   # declared at create, verified at confirm

# ---------------------------------------------------------------------------
# Storage cleanup sweep (Phase 8) — unconfirmed uploads are removed after
# STORAGE_CLEANUP_MAX_AGE_HOURS (default 24 h) along with their MinIO objects.
# ---------------------------------------------------------------------------
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_INTERVAL_SECONDS=21600
STORAGE_CLEANUP_MAX_AGE_HOURS=24

# ---------------------------------------------------------------------------
# Redis (optional) — empty REDIS_URL keeps the in-memory brute-force limiter
# and drops the Redis health check. Set it to share counters across instances.
#
# If you set REDIS_PASSWORD in the root .env (recommended even on the
# internal network), compose passes `--requirepass` and REDIS_URL MUST carry
# the password too: redis://:PASSWORD@redis:6379
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
# JOBS_ENABLED=false   (Phase 8+ — BullMQ background jobs)
