# FinFlow docker-compose — environment template (root level).
#
# Copy to `.env` (gitignored) and fill in real values:
#   cp .env.example .env   &&   edit .env
#
# The app environment for the migrate + finflow-api services lives in
# `server/.env` (template: server/.env.example). DATABASE_URL there must use
# the postgres credentials below (host `postgres`, inside the compose network).

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=finflow
# MUST match the password in server/.env → DATABASE_URL
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finflow

# ---------------------------------------------------------------------------
# MinIO (attachments/backups — used from Phase 4; the container is already up)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=finflow
MINIO_ROOT_PASSWORD=change-me-too

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Docker network shared with your host nginx reverse proxy. Compose creates
# it if missing, or joins an existing network with this name (e.g. set it to
# your existing nginx proxy network).
PROXY_NETWORK=finflow_proxy

# Host port for Phase-1 verification (delete the API `ports` block in
# docker-compose.yml once nginx proxies to the container).
API_PORT=8080
