# Peso-FinFlow web + website behind your host nginx (Dockerized flavour).
#
# When the front-end runs via docker-compose.web.yml, both containers join
# the `finflow_proxy` Docker network, so your host nginx can reverse-proxy
# to them by container name instead of publishing ports.
#
# Example topology:
#   https://app.finflow.example.com   → finflow-web-1  (Flutter web app)
#   https://finflow.example.com       → finflow-website-1 (marketing site)
#
# Copy into nginx (sites-available / conf.d), adjust server_name + TLS
# (certbot --nginx), then: nginx -t && systemctl reload nginx
#
# The web app ALSO publishes host ports by default (8372/8373) — once you
# reverse-proxy with TLS, you can stop publishing them by removing the
# `ports:` block from docker-compose.web.yml.

# --- Web app (Flutter PWA) ---
server {
    listen 80;
    server_name app.finflow.example.com;    # ← your app host

    location / {
        proxy_pass http://finflow-web-1:8372;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Marketing website ---
server {
    listen 80;
    server_name finflow.example.com;        # ← your site host

    location / {
        proxy_pass http://finflow-website-1:8373;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
